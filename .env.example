# Cuenta Gmail que envia los mensajes (no es el correo del destinatario).
# Este archivo no se sube a GitHub: cada persona que corre el servidor necesita su copia.
# Pruebalo con: npm run correo:prueba -- tu.correo@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
# 465 usa true y 587 usa false; si lo dejas vacio se elige segun el puerto.
SMTP_SECURE=true
SMTP_USER=
# Usa una contrasena de aplicacion de Google (16 letras, sin espacios), no tu contrasena habitual.
# Requiere tener activa la verificacion en 2 pasos de la cuenta.
SMTP_PASS=
# Remitente que ven las personas, por ejemplo: eTicket <cuenta.del.equipo@gmail.com>
SMTP_FROM=
# Correo que se convertirá en administrador al registrarse/verificarse.
ADMIN_EMAIL=
# En un servidor publicado con HTTPS, usa true.
COOKIE_SECURE=false
# Solo para ensayos: minutos que dura un apartado (vacío = 10, como pide RN-03).
HOLD_MINUTES=
# Firma que la pasarela manda al webhook de pagos (cabecera X-Webhook-Secret).
# Vacía = webhook deshabilitado. Usa una cadena larga y aleatoria.
PAYMENT_WEBHOOK_SECRET=
